{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/docs/:path*", "destination": "/", "permanent": false },
    { "source": "/vsl/:path*", "destination": "/", "permanent": false },
    { "source": "/src/:path*", "destination": "/", "permanent": false },
    { "source": "/video/:path*", "destination": "/", "permanent": false },
    { "source": "/README.md", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/:path((?!website/).*)", "destination": "/website/:path" }
  ]
}
